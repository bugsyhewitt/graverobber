# ~/.config/systemd/user/graverobber-fpdb.timer  (Packet 07 Appendix A)
#
# Weekly refresh of graverobber's takeover fingerprint database from
# can-i-take-over-xyz. Upstream changes slowly, so weekly is ample; the DB is a
# prior, never the sole signal (detection still requires live multi-signal
# corroboration, pkg/engine D2/A5).
#
# Install (per-user):
#   cp scripts/graverobber-fpdb.timer   ~/.config/systemd/user/
#   cp scripts/graverobber-fpdb.service ~/.config/systemd/user/
#   systemctl --user enable --now graverobber-fpdb.timer
[Unit]
Description=Weekly graverobber takeover fingerprint DB refresh

[Timer]
OnCalendar=weekly
Persistent=true

[Install]
WantedBy=timers.target
